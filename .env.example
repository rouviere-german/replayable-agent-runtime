# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=replayable-agent-runtime
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# HS256 signing secret for local-issuer JWTs (at least 32 bytes). Generate: uv run rar generate-secret
# Without it every protected route answers 401.
APP_JWT_SECRET=
APP_JWT_ISSUER=rar-local
APP_JWT_AUDIENCE=rar-control-plane
APP_JWT_TTL_SECONDS=3600
APP_JWT_LEEWAY_SECONDS=30
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_MAX_INPUT_BYTES=65536
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# Durable runtime.
APP_JOURNAL_PATH=var/rar.db
APP_SINKS_PATH=var/sinks.db
APP_WORKSPACE_DIR=var/workspace
# NORMAL survives killed processes; FULL also survives power loss at a higher append latency.
APP_JOURNAL_SYNCHRONOUS=NORMAL
APP_MAX_HISTORY_EVENTS=10000
APP_LEASE_SECONDS=30
APP_HEARTBEAT_SECONDS=10
APP_POLL_SECONDS=0.5
APP_WORKER_ID=
APP_EMBEDDED_WORKER=true
APP_EGRESS_ALLOWLIST=kb.internal,status.internal

# Models. Tests, demo and bench run offline with the fake provider and never need a key.
APP_PROVIDER=fake
APP_CASSETTE_PATH=
ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-opus-5
APP_LLM_EFFORT=high
APP_LLM_MAX_RETRIES=2
APP_LLM_TIMEOUT_SECONDS=600
APP_LLM_REFUSAL_FALLBACK=true
APP_BUDGET_MAX_STEPS=50
APP_BUDGET_MAX_TOKENS=200000
APP_BUDGET_MAX_USD=1.0
